HESTIA_DATA_ROOT=data
HESTIA_ARTIFACT_ROOT=artifacts

# Copy this file to .env for local use. Never put real credentials in this example.
# Choose one supported hosted provider: groq or openrouter. Use the exact model ID
# offered by that provider; Hestia never chooses a model or provider for you.
# HESTIA_AGENT_PROVIDER=groq
# HESTIA_AGENT_MODEL=<provider-model-id>
# For one key use HESTIA_AGENT_API_KEY. For rotation, use the ordered JSON list
# below instead (never set both); all keys must belong to the chosen provider.
# HESTIA_AGENT_API_KEY=<provider-api-key>
# HESTIA_AGENT_API_KEYS='["<provider-key-1>","<provider-key-2>"]'
# HESTIA_AGENT_REDACTION_SALT=<random-local-secret>

# Bounds apply to both configured and fixture investigations.
HESTIA_AGENT_MAX_TURNS=8
HESTIA_AGENT_MAX_TOOL_CALLS=16
HESTIA_AGENT_MAX_TOTAL_TOKENS=120000
HESTIA_AGENT_MAX_WALL_SECONDS=180
HESTIA_AGENT_MAX_RETRIES=2
HESTIA_AGENT_REQUEST_TIMEOUT_SECONDS=60
HESTIA_AGENT_CONCURRENCY=1

# Fixture pacing is local only; the actor is a display label, not authentication.
HESTIA_AGENT_FIXTURE_PACE_SECONDS=0
HESTIA_ANALYST_NAME=local-analyst
